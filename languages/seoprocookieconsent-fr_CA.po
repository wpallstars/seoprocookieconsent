msgstr[0] "%d jour"
msgstr[1] "%d jours"

#: includes/features/class-seoprocookieconsent-policy.php:115
msgid "Keeps you logged in, only if you log in"
msgstr "Vous garde connecté, seulement si vous vous connectez"

#: includes/features/class-seoprocookieconsent-policy.php:116
msgid "Session, or 14 days with Remember me"
msgstr "Session, ou 14 jours avec Se souvenir de moi"

#: includes/features/class-seoprocookieconsent-policy.php:119
msgid "Fills in your name when you comment, only if you ask it to"
msgstr "Remplit votre nom dans les commentaires, seulement si vous le demandez"

#: includes/features/class-seoprocookieconsent-policy.php:152
msgid "This site uses cookies: small files stored on your device. Necessary cookies are always on. Others are used only if you allow them where the law asks for consent, and you can change your choice at any time."
msgstr "Ce site utilise des témoins, de petits fichiers enregistrés sur votre appareil. Les témoins nécessaires sont toujours activés. Les autres sont utilisés seulement avec votre autorisation lorsque la loi exige le consentement. Vous pouvez modifier votre choix en tout temps."

#. translators: %s: date.
#: includes/features/class-seoprocookieconsent-policy.php:166
#, php-format
