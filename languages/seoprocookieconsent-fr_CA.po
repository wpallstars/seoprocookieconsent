#: includes/migrate/class-seoprocookieconsent-migrate.php:477
#, php-format
msgid "The folder uploads/%s could not be removed. Delete it yourself, or review a new dry run."
msgstr "Impossible de supprimer le dossier uploads/%s. Supprimez-le vous-même ou vérifiez une nouvelle simulation."

