#: includes/features/class-seoprocookieconsent-policy.php:77
msgid "Cookie settings button"
msgstr "Tlačítko Nastavení souborů cookie"

#: includes/features/class-seoprocookieconsent-consent.php:883
msgid "Opens Cookie settings so visitors can change their choices."
msgstr "Otevře Nastavení souborů cookie, aby návštěvníci mohli změnit své volby."

#: includes/features/class-seoprocookieconsent-consent.php:889
msgid "Text"
msgstr "Text"

#: includes/features/class-seoprocookieconsent-consent.php:895
msgid "Show as"
msgstr "Zobrazit jako"

#: includes/features/class-seoprocookieconsent-consent.php:897
msgid "Button"
msgstr "Tlačítko"

#: includes/features/class-seoprocookieconsent-consent.php:898
