msgstr "Nemáte oprávnění tento web skenovat."

#: includes/features/class-seoprocookieconsent-consent.php:975
msgid "Switch on Cookie consent before scanning."
msgstr "Před skenováním zapněte Souhlas se soubory cookie."

#: includes/features/class-seoprocookieconsent-consent.php:1085
