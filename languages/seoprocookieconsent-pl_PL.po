#: includes/class-seoprocookieconsent-settings.php:380
msgid "Unknown setting."
msgstr "Nieznane ustawienie."

#: includes/class-seoprocookieconsent-settings.php:383
msgid "The network administrator sets this for every site, so it cannot be changed here."
msgstr "Administrator sieci ustawia tę opcję dla każdej witryny, więc nie można jej tutaj zmienić."

#: includes/class-seoprocookieconsent-settings.php:1054
msgid "You are not allowed to change these settings."
msgstr "Nie masz uprawnień do zmiany tych ustawień."

#: includes/class-seoprocookieconsent-settings.php:1079
